# Valid values: development, preview, production. "test" is intentionally rejected.
DEPLOYMENT_ENVIRONMENT=production
# Public, build-time browser origin for direct calls to the API Worker.
NEXT_PUBLIC_API_ORIGIN=https://api.example.com
# Public Clerk browser key for the same isolated environment.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace-with-clerk-publishable-key
# Clerk custom JWT template whose aud claim is the exact API origin.
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=whatsapp-api
