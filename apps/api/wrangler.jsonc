{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whatsapp-mcp-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "AWS_KMS_REGION": "us-east-1",
    "DEPLOYMENT_ENVIRONMENT": "production"
  },
  "services": [
    {
      "binding": "PROVIDER_CONTROL",
      "service": "whatsapp-mcp-provider-control"
    }
  ],
  "env": {
    "development": {
      "name": "whatsapp-mcp-api-development",
      "vars": {
        "AWS_KMS_REGION": "us-east-1",
        "DEPLOYMENT_ENVIRONMENT": "development"
      },
      "services": [
        {
          "binding": "PROVIDER_CONTROL",
          "service": "whatsapp-mcp-provider-control-development"
        }
      ]
    },
    "preview": {
      "name": "whatsapp-mcp-api-preview",
      "vars": {
        "AWS_KMS_REGION": "us-east-1",
        "DEPLOYMENT_ENVIRONMENT": "preview"
      },
      "services": [
        {
          "binding": "PROVIDER_CONTROL",
          "service": "whatsapp-mcp-provider-control-preview"
        }
      ]
    },
    "production": {
      "name": "whatsapp-mcp-api",
      "vars": {
        "AWS_KMS_REGION": "us-east-1",
        "DEPLOYMENT_ENVIRONMENT": "production"
      },
      "services": [
        {
          "binding": "PROVIDER_CONTROL",
          "service": "whatsapp-mcp-provider-control"
        }
      ]
    }
  }
}
