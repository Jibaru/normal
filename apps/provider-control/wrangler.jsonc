{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whatsapp-mcp-provider-control",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "DEPLOYMENT_ENVIRONMENT": "production"
  },
  "env": {
    "development": {
      "name": "whatsapp-mcp-provider-control-development",
      "vars": {
        "DEPLOYMENT_ENVIRONMENT": "development"
      }
    },
    "preview": {
      "name": "whatsapp-mcp-provider-control-preview",
      "vars": {
        "DEPLOYMENT_ENVIRONMENT": "preview"
      }
    },
    "production": {
      "name": "whatsapp-mcp-provider-control",
      "vars": {
        "DEPLOYMENT_ENVIRONMENT": "production"
      }
    }
  }
}
