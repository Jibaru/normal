  "private": true,
  "type": "module",
  "scripts": {
    "build": "CLOUDFLARE_HYPERDRIVE_ID=00000000000000000000000000000000 CLOUDFLARE_WEBHOOK_HYPERDRIVE_ID=11111111111111111111111111111111 bun ../../scripts/render-api-wrangler.ts .wrangler/build.jsonc && CI=true wrangler deploy --dry-run --config .wrangler/build.jsonc --outdir dist",
    "dev": "wrangler dev",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
