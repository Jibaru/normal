{
  "name": "@whatsapp-mcp/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./connection-setup": "./src/connection-setup.ts",
    "./config": "./src/config.ts",
    "./connectivity": "./src/connectivity.ts",
    "./migrations": "./src/migrations.ts",
    "./mcp-authorization": "./src/mcp-authorization.ts",
    "./personal-account": "./src/personal-account.ts",
    "./readiness": "./src/readiness.ts",
    "./webhook-event": "./src/webhook-event.ts",
    "./webhook-ingress": "./src/webhook-ingress.ts",
    "./whatsapp-connection": "./src/whatsapp-connection.ts"
  },
  "scripts": {
    "build": "bun build src/config.ts src/connection-setup.ts src/connectivity.ts src/mcp-authorization.ts src/migrations.ts src/personal-account.ts src/readiness.ts src/schema-version.ts src/webhook-event.ts src/webhook-ingress.ts src/whatsapp-connection.ts --outdir dist --target bun",
    "db:check": "bun src/check-cli.ts",
    "db:migrate": "bun src/migrate-cli.ts",
    "lint": "biome check .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@whatsapp-mcp/domain": "workspace:*",
    "effect": "3.22.1",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@types/bun": "^1.3.14",
    "@types/pg": "8.20.0",
    "typescript": "^5"
  }
}
