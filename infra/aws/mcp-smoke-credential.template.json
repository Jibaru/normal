{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Rotation-capable secret and narrowly scoped GitHub OIDC role for production MCP smoke.",
  "Parameters": {
    "EmergencyAssumerArn": {
      "Description": "Human bootstrap authority retained for recovery and reauthorization.",
      "Type": "String"
    },
    "GitHubOidcProviderArn": {
      "AllowedPattern": "^arn:aws:iam::[0-9]{12}:oidc-provider/token.actions.githubusercontent.com$",
      "Type": "String"
    },
    "GitHubRepositoryIdentity": {
      "AllowedPattern": "^[A-Za-z0-9_.-]+@[0-9]+/[A-Za-z0-9_.-]+@[0-9]+$",
      "Default": "cuevaio@83598208/normal@1317490924",
      "Type": "String"
    }
  },
  "Resources": {
    "McpSmokeRefreshCredential": {
      "DeletionPolicy": "Retain",
      "Properties": {
        "Description": "Current one-time refresh credential for deployment MCP smoke. Bootstrapped out of band.",
        "Name": "whatsapp-mcp/production/mcp-smoke-refresh"
      },
      "Type": "AWS::SecretsManager::Secret",
      "UpdateReplacePolicy": "Retain"
    },
    "McpSmokeCredentialRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": [
                    {
                      "Fn::Sub": "repo:${GitHubRepositoryIdentity}:environment:production"
                    },
                    {
                      "Fn::Sub": "repo:${GitHubRepositoryIdentity}:environment:production-launch-gate"
                    }
                  ]
                }
              },
              "Effect": "Allow",
              "Principal": { "Federated": { "Ref": "GitHubOidcProviderArn" } }
            },
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": { "AWS": { "Ref": "EmergencyAssumerArn" } }
            }
          ],
          "Version": "2012-10-17"
        },
        "Description": "Reads and rotates only the production deployment-smoke refresh credential.",
        "MaxSessionDuration": 3600,
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": [
                    "secretsmanager:DescribeSecret",
                    "secretsmanager:GetSecretValue",
                    "secretsmanager:PutSecretValue"
                  ],
                  "Effect": "Allow",
                  "Resource": { "Ref": "McpSmokeRefreshCredential" }
                }
              ],
              "Version": "2012-10-17"
            },
            "PolicyName": "RotateMcpSmokeRefreshCredential"
          }
        ],
        "RoleName": "whatsapp-mcp-production-mcp-smoke-credential"
      },
      "Type": "AWS::IAM::Role"
    }
  },
  "Outputs": {
    "McpSmokeCredentialRoleArn": {
      "Value": { "Fn::GetAtt": ["McpSmokeCredentialRole", "Arn"] }
    },
    "McpSmokeRefreshSecretId": {
      "Value": { "Ref": "McpSmokeRefreshCredential" }
    }
  }
}
